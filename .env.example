# Neon (serverless Postgres) connection string - required
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign JWT session cookies (min 16 chars, 32+ in production)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Credentials for the seeded admin account (created by `npm run db:seed`)
ADMIN_EMAIL=admin@mapoly.edu.ng
ADMIN_PASSWORD=ChangeMe123!

# Absolute URL of the deployed app (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
